{
  "name": "orders-products-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n web,gateway,orders,products,realtime -c cyan,green,yellow,magenta,blue \"npm run dev -w @inventory/web\" \"PORT=3100 npm run dev -w @inventory/gateway\" \"npm run dev -w @inventory/orders-service\" \"npm run dev -w @inventory/products-service\" \"npm run dev -w @inventory/realtime-service\"",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/prisma/seed.ts",
    "format": "prettier --write .",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.1.3",
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
