{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "./src",
    "paths": {
      "app.module": ["app.module"],
      "infrastructure/*": ["infrastructure/*"],
      "presence/*": ["presence/*"]
    },
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
